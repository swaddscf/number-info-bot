# توكن البوت من @BotFather (إجباري)
BOT_TOKEN=

# معرّف حساب المالك (رقمي) — يفعّل لوحة التحكم /admin (إجباري للأوامر)
# احصل عليه من البوت @userinfobot عند أخذك لرقم معرفك
OWNER_ID=

# (اختياري) لتفعيل عرض يوزر تيليجرام :
# احصل على API_ID و API_HASH من https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# ضع هنا ناتج الأمر: npm run setup (يُولَّد مرة واحدة)
TG_SESSION=

# (اختياري) منفذ خادم الـ HTTP (REST الكامل لبقاء النشر حيًا)
PORT=8080

# (اختياري) مجلد حفظ البيانات (للاستضافة: =/data وقم بربط حجم persistent)
DATA_DIR=

# (اختياري) لتفعيل وضع الويب هوك بدل الاستطلاع:
# ضع رابط موقعك العام كاملًا أي: https://نطاقك/webhook
# (عند وجوده يشتغل الويبهوك، وعند غيابه يعمل الاستطلاع افتراضيًا)
WEBHOOK_URL=